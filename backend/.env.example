# Copier ce fichier en `.env` puis adapter les valeurs. Ne jamais versionner `.env`.

# ---------------------------------------------------------------- Securite
# Obligatoire des que DEBUG=0 : au moins 32 caracteres aleatoires.
# Generer une cle : python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
CLE_SECRETE=change-moi-en-production-avec-une-cle-d-au-moins-32-caracteres
# 1 en developpement, 0 en production.
DEBUG=1
# Hotes autorises en production (separes par des virgules), ex. ecole.exemple.mr,www.ecole.exemple.mr
HOTES_AUTORISES=localhost,127.0.0.1
# 1 derriere un reverse proxy HTTPS : cookies securises, redirection HTTPS, HSTS.
FORCER_HTTPS=0

# ---------------------------------------------------------------- Base de donnees
# Mettre 1 pour utiliser SQLite (demo, tests rapides) au lieu de MySQL/MariaDB.
UTILISER_SQLITE=0
# Chemin du fichier SQLite (facultatif ; par defaut backend/db.sqlite3).
# FICHIER_SQLITE=
BD_NOM=ecole
BD_UTILISATEUR=root
BD_MOT_DE_PASSE=root
BD_HOTE=127.0.0.1
BD_PORT=3306

# ---------------------------------------------------------------- Frontend
# Origines autorisees du frontend (separees par des virgules).
ORIGINES_CORS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- Documents
# Chemin d'un logo (PNG/JPEG) imprime sur les bulletins et documents PDF. Facultatif.
# LOGO_ECOLE=

# ---------------------------------------------------------------- WhatsApp (facultatif)
# Sans ces variables, l'application fonctionne en mode « lien wa.me » : le message est pre-rempli
# et envoye depuis le telephone de l'ecole. Pour l'envoi automatique, il faut un compte
# WhatsApp Business Platform (Meta) et un modele de message approuve. Voir DEPLOIEMENT.md.
# WHATSAPP_JETON=
# WHATSAPP_ID_NUMERO=
# Nom du modele de message approuve par Meta (ex. absence_eleve).
# WHATSAPP_MODELE=
# Modele approuve pour les messages en arabe (utilise quand le parametre « Langue des messages WhatsApp » vaut arabe).
# WHATSAPP_MODELE_AR=
# WHATSAPP_LANGUE_AR=ar
# WHATSAPP_LANGUE=fr
# WHATSAPP_VERSION_API=v21.0
# WHATSAPP_URL_API=https://graph.facebook.com
# Jeton choisi par vous, saisi dans la console Meta pour verifier l'URL du webhook.
# WHATSAPP_JETON_VERIFICATION=
# Secret de l'application Meta : sert a verifier la signature (HMAC) des webhooks recus.
# WHATSAPP_SECRET_APPLICATION=
# Nombre maximal de tentatives d'envoi avant d'abandonner un message.
# WHATSAPP_MAX_TENTATIVES=3
